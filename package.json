{
  "name": "fly-habitat",
  "version": "0.1.0",
  "description": "Realtime LIF simulation of the FlyWire brain + MANC spine + flybody body, all in WebGPU/WASM in the browser.",
  "type": "module",
  "homepage": "https://fly.siddhvasudev.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/vasu-devs/fly-habitat.git"
  },
  "author": {
    "name": "Ahmet Barış Günaydın",
    "email": "hi@barisgunaydin.com"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node tools/copy-notices.mjs",
    "typecheck": "tsc --noEmit",
    "check:py": "PYTHONDONTWRITEBYTECODE=1 python3 -m compileall -q tools",
    "check:rs": "cargo check --locked --manifest-path tools/cpu-bench/Cargo.toml",
    "check:sh": "for f in tools/*.sh; do bash -n \"$f\"; done",
    "check:json": "node -e \"const fs=require('fs');for(const f of ['package.json','vercel.json','r2-cors.json','.zenodo.json','tsconfig.json']){JSON.parse(fs.readFileSync(f,'utf8'));}JSON.parse(fs.readFileSync('wrangler.jsonc','utf8').replace(/^\\s*\\/\\/.*/gm,''));console.log('json-ok')\"",
    "data": "bash tools/download_data.sh",
    "convert": ".venv/bin/python tools/build_csr.py",
    "test:e2e": "playwright test",
    "test:e2e:list": "playwright test --list",
    "test:unit": "node --experimental-strip-types --test --test-concurrency=2 tests-unit/*.test.ts",
    "bench:brain": "playwright test tests/bench.spec.ts --reporter=list",
    "build:slim": "npm run build && node tools/slim-dist.mjs",
    "build:vercel": "node tools/fetch-release-assets.mjs && npm run build",
    "preview:habitat": "node tools/serve-habitat.mjs",
    "deploy": "npm run build:slim && npx --yes wrangler pages deploy dist --project-name=webgpu-fly --branch=main",
    "deploy:hf": "npm run build:slim && cp space/README.md space/.gitattributes NOTICE LICENSE LICENSE-FLYBODY LIMITATIONS.md dist/ && rm -f dist/_headers && hf upload abgunaydin/webgpu-fly dist . --repo-type=space",
    "deploy:vercel": "vercel --prod --scope vasu-devs-projects-a637f703",
    "deploy:r2": "bash tools/upload_to_r2.sh"
  },
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0",
    "@webgpu/types": "^0.1.69",
    "typescript": "^6.0.2",
    "vite": "^8.0.8"
  },
  "dependencies": {
    "@mujoco/mujoco": "^3.8.0",
    "@types/three": "^0.184.0",
    "three": "^0.184.0"
  }
}
